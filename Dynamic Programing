class Solution {
    int[] dp;
    public int rob(int[] nums) {
        int length = nums.length;
        this.dp = new int[length+1];
        Arrays.fill(dp,-1);
        return f(length-1,nums);
    }
    private int f(int n,int[] nums){
        if(n==0) return dp[0] = nums[0];
        if(n<0) return 0;
        if(dp[n]!=-1) return dp[n];

        int take = nums[n] + f(n-2,nums);
        int skip = 0 + f(n-1,nums);

        return dp[n] = Math.max(take,skip);
    }
}

