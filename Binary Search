Q2. Given a sorted array arr[] with possibly some duplicates, find the first and last occurrences of an element x in the given array.
Note: If the number x is not found in the array then return both the indices as -1.

Sol.

import java.util.*;

class Solution {
    
    ArrayList<Integer> find(int arr[], int x) {
        ArrayList<Integer> res = new ArrayList<>();
        
        int first = fo(arr, x);
        int last = lo(arr, x);
        
        res.add(first);
        res.add(last);
        
        return res;
    }
    
    int fo(int arr[], int x){
        int l = 0;
        int r = arr.length - 1;
        int ans = -1;
        
        while(l <= r){
            int mid = l + (r - l) / 2;
            
            if(arr[mid] == x){
                ans = mid;
                r = mid - 1; // move left
            }
            else if(arr[mid] > x){
                r = mid - 1;
            }
            else{
                l = mid + 1;
            }
        }
        return ans;
    }
    
    int lo(int arr[], int x){
        int l = 0;
        int r = arr.length - 1;
        int ans = -1;
        
        while(l <= r){
            int mid = l + (r - l) / 2;
            
            if(arr[mid] == x){
                ans = mid;
                l = mid + 1; // move right
            }
            else if(arr[mid] > x){
                r = mid - 1;
            }
            else{
                l = mid + 1;
            }
        }
        return ans;
    }
}

