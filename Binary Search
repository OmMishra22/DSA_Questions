Q9. Given an array of integers arr[] that is first strictly increasing and then maybe strictly decreasing, find the bitonic point, that is the maximum element in the array.
Bitonic Point is a point before which elements are strictly increasing and after which elements are strictly decreasing.

Note: It is guaranteed that the array contains exactly one bitonic point.

Sol. 


class Solution {
    public int findMaximum(int[] arr) {
        int l = 0 ;
        int r = arr.length - 1 ;
        int n = arr.length-1;
        
        if(arr[1]<arr[0]){
            return arr[0];
        }
        if(arr[n-1]<arr[n]){
            return arr[n];
        }
        
        while(l<=r){
            int mid = l + (r-l)/2 ;
            
            if(arr[mid] > arr[mid+1] && arr[mid] > arr[mid-1]){
                return arr[mid];
            }
            else if(arr[mid]>arr[mid+1] && arr[mid] < arr[mid-1]){
                r = mid - 1;
            }
            else{
                l = mid + 1 ;
            }
        }
        return 0;
        
    }
}

