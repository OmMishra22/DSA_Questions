Q8. Given a binary array nums, return the maximum length of a contiguous subarray with an equal number of 0 and 1
Sol.

class Solution {
    public int findMaxLength(int[] nums) {

        HashMap<Integer, Integer> map = new HashMap<>();

        map.put(0, -1);

        int sum = 0;
        int maxLen = 0;

        for (int i = 0; i < nums.length; i++) {

            if (nums[i] == 0) {
                sum += -1;
            } else {
                sum += 1;
            }

            if (map.containsKey(sum)) {

                int len = i - map.get(sum);
                maxLen = Math.max(maxLen, len);

            } else {

                map.put(sum, i);
            }
        }

        return maxLen;
    }
}
