Q6. Given an integer array nums, return an array answer such that answer[i] is equal to the product of all the elements of nums except nums[i].
The product of any prefix or suffix of nums is guaranteed to fit in a 32-bit integer.
You must write an algorithm that runs in O(n) time and without using the division operation.

Sol. 

class Solution {
    public int[] productExceptSelf(int[] nums) {
        int[] prefixProd = new int[nums.length+2];
        int[] suffixProd = new int[nums.length+2];
        int[] ans = new int[nums.length];
        prefixProd[0] = 1;
        prefixProd[nums.length+1] = 1;
        suffixProd[0] = 1;
        suffixProd[nums.length+1] = 1;

        for(int i = 0; i < nums.length ; i++){
            prefixProd[i+1] = nums[i]*prefixProd[i];
            suffixProd[nums.length - i] = nums[nums.length-1-i]*suffixProd[nums.length+1-i];
        }
        for(int i = 0 ; i < nums.length ; i++){
            
            ans[i] = prefixProd[i]*suffixProd[i+2];
        }

        return ans;
    }
}

